# Local demo store settings (copy to .env and adjust).
# .env is gitignored; do not commit secrets.

HTTP_EXPOSING_PORT=8069

DB_HOST=localhost
DB_PORT=5432
DB_NAME=tamara_demo_odoo
# Set DB_USER to use an existing PostgreSQL (install is skipped).
# Leave DB_USER empty to install local PostgreSQL and connect as your OS user (no password).
DB_USER=
DB_PASSWORD=

# Public HTTPS URL for Tamara webhooks/redirects (ngrok).
# Example: https://abc123.ngrok-free.app
# Leave empty to use http://localhost:<HTTP_EXPOSING_PORT>.
NGROK_URL=

# Set to 1 to start an ngrok tunnel automatically with run-website.sh
# (requires the `ngrok` CLI). You can also pass --ngrok.
NGROK_ENABLED=0
